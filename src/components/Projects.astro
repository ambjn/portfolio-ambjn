---
import { projects, type ProjectLinks } from "../data/content";

const linkLabels: Record<keyof ProjectLinks, string> = {
  live: "Live",
  preview: "Preview",
  component: "Component",
  github: "GitHub",
  appStore: "App Store",
  testflight: "TestFlight",
  website: "Website",
  npm: "npm",
};

const getProjectLinks = (links?: ProjectLinks) =>
  links
    ? (Object.entries(links) as [keyof ProjectLinks, string | undefined][]).filter(
        (entry): entry is [keyof ProjectLinks, string] => Boolean(entry[1]),
      )
    : [];

const desktopCardLayouts = [
  "lg:col-span-4",
  "lg:col-span-2 lg:min-h-60",
  "lg:col-span-2 lg:min-h-60",
  "lg:col-span-2",
  "lg:col-span-2",
  "lg:col-span-4",
  "lg:col-span-2",
  "lg:col-span-2",
  "lg:col-span-2",
  "lg:col-span-2",
  "lg:col-span-2",
];

const priority = new Map(["Jackfruit", "Sprout", "Pillow"].map((title, index) => [title, index]));
const orderedProjects = projects
  .map((project, sourceIndex) => ({
    ...project,
    links: getProjectLinks(project.links),
    sourceIndex,
  }))
  .sort((a, b) => (priority.get(a.title) ?? a.sourceIndex + priority.size) - (priority.get(b.title) ?? b.sourceIndex + priority.size));

---

<section id="projects" class="mx-auto mt-10 max-w-4xl border-t border-white/10 pt-16 pb-8 sm:mt-16 sm:pt-24 sm:pb-10">
  <h2 class="mb-10 flex items-center gap-3 text-xl font-semibold sm:mb-14 sm:text-2xl">
    <span aria-hidden="true" class="h-px w-8 bg-white/20"></span> Work
  </h2>
  <div data-project-grid class="grid grid-cols-1 items-start gap-3 sm:grid-cols-2 lg:grid-flow-dense lg:auto-rows-[4px] lg:grid-cols-6">
    {orderedProjects.map((project, index) => (
      <article data-project-card class:list={["group flex self-start flex-col rounded-xl border border-white/10 bg-white/5 p-4 transition-colors hover:border-white/20 hover:bg-white/[0.07] sm:p-5", desktopCardLayouts[index]]}>
        <div class="flex items-center justify-between gap-3">
          <h3 class="text-lg font-semibold text-white">{project.title}</h3>
          {project.images?.length && (
            <button
              type="button"
              data-screenshots={JSON.stringify(project.images)}
              data-project-title={project.title}
              class="grid size-11 shrink-0 place-items-center rounded-full border border-white/20 bg-white/15 text-base text-white transition-colors hover:bg-white/25 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:size-9"
              aria-label={`View ${project.title} screenshots`}
              title="View screenshots"
            >
              <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                <circle cx="9" cy="9" r="2"></circle>
                <path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"></path>
              </svg>
            </button>
          )}
        </div>
        <p class="mt-3 whitespace-pre-line text-sm leading-6 text-neutral-400">{project.description}</p>
        {project.links.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {project.links.map(([key, href]) => (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-11 items-center gap-1.5 rounded-full border border-white/10 bg-white/10 px-3.5 py-1.5 text-xs font-medium text-white transition-colors hover:border-white/20 hover:bg-white/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:min-h-9"
              >
                {linkLabels[key]}
                <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        )}
      </article>
    ))}
  </div>
</section>

<dialog
  id="screenshot-dialog"
  aria-labelledby="screenshot-dialog-title"
  class="m-auto max-h-[92dvh] w-[min(92vw,64rem)] rounded-2xl border border-white/15 bg-[#111] p-0 text-white shadow-2xl backdrop:bg-black/85 backdrop:backdrop-blur-sm"
>
  <div class="flex items-center justify-between gap-4 border-b border-white/10 px-4 py-3 sm:px-5">
    <h2 id="screenshot-dialog-title" class="truncate text-base font-semibold sm:text-lg"></h2>
    <button
      type="button"
      data-close-dialog
      class="grid size-11 shrink-0 place-items-center rounded-full border border-white/10 text-xl text-neutral-300 transition-colors hover:bg-white/10 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      aria-label="Close screenshots"
    >
      ×
    </button>
  </div>
  <div data-dialog-images class="flex max-h-[calc(92dvh-4.25rem)] snap-x snap-mandatory items-center gap-4 overflow-x-auto p-4 sm:p-6"></div>
</dialog>

<script>
  const projectGrid = document.querySelector<HTMLElement>("[data-project-grid]");
  const projectCards = document.querySelectorAll<HTMLElement>("[data-project-card]");

  const packProjectGrid = () => {
    if (!projectGrid) return;
    if (!window.matchMedia("(min-width: 64rem)").matches) {
      projectCards.forEach((card) => card.style.removeProperty("grid-row-end"));
      return;
    }

    const styles = getComputedStyle(projectGrid);
    const rowHeight = Number.parseFloat(styles.gridAutoRows);
    const rowGap = Number.parseFloat(styles.rowGap);
    projectCards.forEach((card) => {
      card.style.removeProperty("grid-row-end");
      const span = Math.ceil((card.scrollHeight + rowGap) / (rowHeight + rowGap));
      card.style.gridRowEnd = `span ${span}`;
    });
  };

  const resizeObserver = new ResizeObserver(packProjectGrid);
  projectCards.forEach((card) => resizeObserver.observe(card));
  window.addEventListener("resize", packProjectGrid, { passive: true });
  packProjectGrid();

  const dialog = document.querySelector<HTMLDialogElement>("#screenshot-dialog");
  const dialogTitle = document.querySelector<HTMLElement>("#screenshot-dialog-title");
  const imageContainer = document.querySelector<HTMLElement>("[data-dialog-images]");

  document.querySelectorAll<HTMLButtonElement>("[data-screenshots]").forEach((button) => {
    button.addEventListener("click", () => {
      if (!dialog || !dialogTitle || !imageContainer) return;

      const images = JSON.parse(button.dataset.screenshots ?? "[]") as string[];
      const projectTitle = button.dataset.projectTitle ?? "Project";
      dialogTitle.textContent = `${projectTitle} screenshots`;
      imageContainer.replaceChildren(
        ...images.map((src, index) => {
          const image = document.createElement("img");
          image.src = src;
          image.alt = `${projectTitle} screenshot ${index + 1}`;
          image.loading = index === 0 ? "eager" : "lazy";
          image.className = "max-h-[calc(92dvh-7rem)] max-w-[85vw] shrink-0 snap-center rounded-xl border border-white/10 object-contain sm:max-w-full";
          return image;
        }),
      );
      dialog.showModal();
    });
  });

  document.querySelector<HTMLButtonElement>("[data-close-dialog]")?.addEventListener("click", () => dialog?.close());
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
