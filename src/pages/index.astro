---
import Layout from "../layouts/Layout.astro";
import Bio from "../components/Bio.astro";
import Projects from "../components/Projects.astro";
import Work from "../components/Work.astro";
import Footer from "../components/Footer.astro";
import { personalInfo } from "../data/content";

const description = `${personalInfo.name} — developer building AI, mobile, Web3, and real-time products.`;
---

<Layout title="Amber's Portfolio" description={description}>
  <div class="mx-auto max-w-4xl px-4 py-6 sm:px-6 sm:py-12">
    <main>
      <Bio />
      <div class="grid items-start gap-12 md:grid-cols-2 md:gap-0">
        <Projects />
        <div class="md:ml-10 md:border-l md:border-white/10 md:pl-10">
          <Work />
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
